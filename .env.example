# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Backend (ADR 0002). Compose services and the matcher come with ADR 0003.
DATABASE_URL=postgres://jobradar:change-me@localhost:5432/jobradar?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
