# Copy to .env and fill in every "change-me". .env is git-ignored; never commit real values.
# Generate a secret: openssl rand -hex 24

# Postgres (ADR 0003). Used only when the pgdata volume is first created; changing them
# later does not change the existing roles' passwords.
POSTGRES_PASSWORD=change-me
JOBRADAR_DB_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me

# Matcher (ADR 0001, 0004). MATCHER_VERSION must equal contracts/MATCHER_VERSION, and
# ../jobradar-matcher must be checked out at contracts/MATCHER_REF.
MATCHER_TOKEN=change-me-at-least-16-characters
MATCHER_VERSION=0.1.0
# MATCHER_SRC=../jobradar-matcher

LOG_LEVEL=info

# Only for running the backend outside Docker (`go run ./cmd/jobradar ...`), against a
# Postgres you started yourself. Compose builds its own DATABASE_URL.
# DATABASE_URL=postgres://jobradar:change-me@localhost:5432/jobradar?sslmode=disable
# HTTP_ADDR=:8080
# REQUEST_TIMEOUT=30s
# SHUTDOWN_TIMEOUT=10s

# Ingestion (ADR 0005), defaults shown. Compose passes them through when set.
# SYNC_INTERVAL=6h      # resync a source once its last successful sync is this old
# SYNC_CONCURRENCY=4    # sources synced at the same time
