      "notes": [
        "Free display API; terms are in every response's meta.license",
        "Global board, not remote-only; the list has an excerpt, /api/v1/jobs/{id} the full description"
      ],
      "verification": {
        "status": "live_checked",
        "date": "2026-11-14",
        "result": "200, 25 per page of ~112k; mostly dev roles"
      },
      "implemented_in_jobradar": true,
      "terms": [
        "Show a visible 'Powered by Dev Global Jobs' link to https://devglobaljobs.com",
        "Keep each job's link"
      ]
    },
