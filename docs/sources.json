{
  "catalog_version": "2.0.0",
  "project": "jobradar",
  "description": "Reviewed job sources for jobradar: public job-board APIs and ATS platforms, each checked live",
  "last_reviewed": "2026-11-14",
  "how_to_use": [
    "A catalog of candidate source kinds, not jobradar config: a kind is added as an adapter per jobradar's 'new source kind' rule (docs, terms, recorded testdata), then registered",
    "implemented_in_jobradar: true means an adapter exists; boards are added as rows via POST /api/v1/sources",
    "enabled: false means verify the terms (or get an API key) first",
    "terms are binding: copy them into the adapter's package doc"
  ],
  "defaults": {
    "authentication": "none",
    "http_method": "GET",
    "request_timeout_seconds": 30,
    "retry": {
      "max_attempts": 3,
      "strategy": "exponential_backoff",
      "retry_status_codes": [
        429,
        500,
        502,
        503,
        504
      ]
    },
    "requirements": [
      "Preserve the original job URL and source identifier",
      "Respect source rate limits and attribution terms",
      "Close a job as missing only after a complete listing (jobradar ingest.ErrTruncated rule)"
    ]
  },
  "aggregators": [
    {
      "id": "himalayas",
      "name": "Himalayas",
      "enabled": true,
      "priority": "P0",
      "base_url": "https://himalayas.app",
      "endpoint": "https://himalayas.app/jobs/api",
      "documentation": "https://himalayas.app/docs/remote-jobs-api",
      "method": "GET",
      "format": "json",
      "authentication": "none",
      "pagination": {
        "type": "cursor",
        "response_cursor_field": "nextCursor"
      },
      "data": [
        "title",
        "company",
        "description",
        "location",
        "salary",
        "seniority",
        "timezone",
        "employment_type",
        "application_url"
      ],
      "notes": [
        "Already an adapter in jobradar (internal/ingest/himalayas)",
        "Search stops at 500 jobs: narrow the query"
      ],
      "verification": {
        "status": "live_checked",
        "date": "2026-11-14",
        "result": "200, 20 jobs per page, nextCursor"
      },
      "implemented_in_jobradar": true,
      "terms": [
        "Keep applicationLink as the job URL",
        "Show 'via Himalayas' with that link",
        "Never pass jobs on to other boards or feeds",
        "Close expired jobs (expires_at)"
      ]
    },
    {
      "id": "jobicy",
      "name": "Jobicy",
      "enabled": true,
      "priority": "P0",
      "base_url": "https://jobicy.com",
      "endpoint": "https://jobicy.com/api/jobs",
      "documentation": "https://jobicy.com/jobs-rss-feed",
      "method": "GET",
      "format": "json",
      "authentication": "none",
      "pagination": {
        "type": "cursor",
        "response_cursor_field": "nextCursor",
        "window": "7 days"
      },
      "data": [
        "title",
        "company",
        "description",
        "location",
        "salary",
        "job_type",
        "job_level",
        "application_url",
        "publication_date"
      ],
      "notes": [
        "Feed covers recent jobs only",
        "Filters: count, geo, industry, tag"
      ],
      "verification": {
        "status": "live_checked",
        "date": "2026-11-14",
        "result": "200, 100 jobs; about a third tech roles"
      },
      "implemented_in_jobradar": true,
      "terms": [
        "Credit Jobicy with a direct link to the source",
        "Apply buttons must go to the job URL from the feed"
      ],
      "rate_limit": "Poll at most once per hour"
    },
    {
      "id": "remoteok",
      "name": "Remote OK",
      "enabled": true,
      "priority": "P1",
      "base_url": "https://remoteok.com",
      "endpoint": "https://remoteok.com/api",
      "documentation": "https://remoteok.com/faq",
      "method": "GET",
      "format": "json",
      "authentication": "none",
      "pagination": {
        "type": "none",
        "notes": "Public feed returns a limited recent listing"
      },
      "data": [
        "title",
        "company",
        "description",
        "location",
        "tags",
        "salary",
        "application_url",
        "publication_date"
      ],
      "notes": [
        "Skip element 0 (legal notice, not a job)",
        "Recent jobs only, no paging"
      ],
      "verification": {
        "status": "live_checked",
        "date": "2026-11-14",
        "result": "200, 97 jobs; element 0 is the legal notice"
      },
      "implemented_in_jobradar": true,
      "terms": [
        "Link back (followed link, no nofollow) to the Remote OK URL",
        "Mention 'Remote OK' as the source",
        "Do not use the Remote OK logo"
      ]
    },
    {
      "id": "remotive",
      "name": "Remotive",
      "enabled": true,
      "priority": "P2",
      "base_url": "https://remotive.com",
      "endpoint": "https://remotive.com/api/remote-jobs",
      "documentation": "https://remotive.com/api-documentation",
      "method": "GET",
      "format": "json",
      "authentication": "none",
      "pagination": {
        "type": "source_specific",
        "notes": "Public feed has limited results"
      },
      "data": [
        "title",
        "company",
        "description",
        "category",
        "job_type",
        "location",
        "salary",
        "publication_date",
        "application_url"
      ],
      "notes": [
        "Small, 24h-delayed feed: low yield, keep the poll interval at 6h or more"
      ],
      "verification": {
        "status": "live_checked",
        "date": "2026-11-14",
        "result": "200, 16 jobs; jobs delayed 24h"
      },
      "implemented_in_jobradar": true,
      "terms": [
        "Link back to the Remotive URL and name Remotive as the source",
        "Never submit Remotive jobs to third-party sites (Jooble, Google Jobs, LinkedIn...)",
        "Do not use its jobs to collect signups"
      ],
      "rate_limit": "At most 4 requests per day (excess is blocked)"
    },
    {
      "id": "devglobaljobs",
      "name": "Dev Global Jobs",
      "enabled": true,
      "priority": "P1",
      "endpoint": "https://devglobaljobs.com/api/v1/jobs",
      "documentation": "https://devglobaljobs.com/developers",
      "method": "GET",
